{
  "manifest_version": 3,
  "name": "Anihub Reanime 연결 도우미",
  "version": "1.0.0",
  "description": "내 Anihub에서 요청한 회차의 Reanime 영상 플레이어 주소만 조회합니다.",
  "host_permissions": ["https://reanime.to/*"],
  "background": {"service_worker": "background.mjs", "type": "module"},
  "content_scripts": [{
    "matches": ["https://anime-eight-virid.vercel.app/*"],
    "js": ["content.js"],
    "run_at": "document_start"
  }]
}
